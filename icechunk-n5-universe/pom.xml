<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.earthmover.icechunk</groupId>
		<artifactId>icechunk-java-parent</artifactId>
		<version>0.1.0-SNAPSHOT</version>
	</parent>

	<artifactId>icechunk-n5-universe</artifactId>
	<name>icechunk-n5-universe</name>
	<description>Opens icechunk URLs, such as s3://bucket/repo|icechunk://branch.main/path, through n5-universe's N5Factory. Needs an n5-universe with the KeyValueAccessProvider interface, which no release has yet.</description>

	<properties>
		<!-- KeyValueAccessProvider is not in a released n5-universe yet. -->
		<n5-universe-provider.version>3.1.1-SNAPSHOT</n5-universe-provider.version>
	</properties>

	<repositories>
		<!-- n5, n5-zarr and n5-universe are published here, not on Maven Central. -->
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
	</repositories>

	<dependencies>
		<dependency>
			<groupId>io.earthmover.icechunk</groupId>
			<artifactId>icechunk-n5</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- Provided: Fiji and other n5 applications bring their own. -->
		<dependency>
			<groupId>org.janelia.saalfeldlab</groupId>
			<artifactId>n5</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.janelia.saalfeldlab</groupId>
			<artifactId>n5-universe</artifactId>
			<version>${n5-universe-provider.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.janelia.saalfeldlab</groupId>
			<artifactId>n5-zarr</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifestEntries>
							<Automatic-Module-Name>io.earthmover.icechunk.n5.universe</Automatic-Module-Name>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
